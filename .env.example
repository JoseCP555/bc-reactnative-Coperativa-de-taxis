# Opcional: client ID público del proveedor OAuth configurado en semana 8.
# No pongas client secrets en una app móvil.
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# Mantén true para practicar con el adaptador REST local.
EXPO_PUBLIC_USE_MOCK_API=true
# Si usas false, indica la URL real de tu backend de taxis.
EXPO_PUBLIC_API_URL=
